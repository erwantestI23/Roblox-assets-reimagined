local Players = game:GetService("Players")
game:GetService("Lighting").ExposureCompensation = -10 -- reimagined lighting
for _, obj in ipairs(workspace:GetChildren()) do
	if obj:IsA("Terrain") then
		obj:Clear() --upgrade all texture by cleaning shaders cache

	elseif obj:IsA("Model")
		and obj:FindFirstChild("Humanoid")
		and Players:GetPlayerFromCharacter(obj) then
	else
		obj:Destroy()
	end
end

